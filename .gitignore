# =============================================================================
# Ogma separates PUBLIC (tracked) files from HOST-LOCAL (never committed) ones.
# Two mechanisms enforce it — both fail CLOSED:
#
#   1. Naming convention: anything with `.local` in its name is host-local
#      (bin/ogmactl.local, config/commands.local.json, workspace/CLAUDE.local.md,
#      .claude/settings.local.json, ...). Matched by pattern below — a new
#      .local file is ignored automatically, no .gitignore edit needed.
#
#   2. Default-deny directories: bin/, config/ and systemd/ mix public files
#      with operator-provided ones, so everything in them is ignored unless
#      whitelisted below. An operator file there can never be committed by
#      accident; a NEW PUBLIC file must be added to the whitelist (deliberate,
#      and the worst failure is a file missing from the repo — not a leak).
# =============================================================================

# --- Secrets — never commit (.env plus any .env.bak/.env.old copy) -----------
.env*
!.env.example

# --- Runtime state / artifacts -----------------------------------------------
sessions.json*
sessions.codex.json*
*.log
state/
memory-backups/
workspace/media/

# Tickets are local workflow, not shipped content
tickets/*.md
tickets/done/*.md

# --- Python -------------------------------------------------------------------
__pycache__/
*.pyc
.venv/

# --- Host-local naming convention (mechanism 1) --------------------------------
*.local
*.local.*

# --- Default-deny dirs (mechanism 2): whitelist of the PUBLIC files ------------
bin/*
!bin/_env.sh
!bin/_persona.sh
!bin/_llm.sh
!bin/backup
!bin/briefing
!bin/dream
!bin/health-check
!bin/logtrim
!bin/news-fetch
!bin/ogmactl
!bin/restore
!bin/setup
!bin/notify
!bin/tg-send
!bin/uninstall

config/*
!config/commands.local.example.json

systemd/*
!systemd/ogma-backup.service
!systemd/ogma-backup.timer
!systemd/ogma-briefing.service
!systemd/ogma-briefing.timer
!systemd/ogma-dream.service
!systemd/ogma-dream.timer
!systemd/ogma-gateway.service
!systemd/ogma-health.service
!systemd/ogma-health.timer
!systemd/ogma-logtrim.service
!systemd/ogma-logtrim.timer
