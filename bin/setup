#!/usr/bin/env bash
# setup — interactive first-time installer for Ogma.
#
# Walks a new user through configuring THEIR OWN copy: creating .env, pasting their
# Telegram bot token, filling persona/hook placeholders, installing skills, and
# (optionally) installing the systemd user services. Ships no credentials — every
# secret is entered by the user here. Safe to re-run; it won't clobber an existing
# .env without asking.
set -uo pipefail

OGMA_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV="$OGMA_DIR/.env"
EXAMPLE="$OGMA_DIR/.env.example"
PY="python3"
MATRIX_ENV="$OGMA_DIR/config/matrix_bot.env.local"

# Read config with the same precedence as gateway.py: .env first, then the
# Matrix host-local file when that transport is selected.
. "$OGMA_DIR/bin/_env.sh"
config_value() {
  local key="$1" value
  value="$(env_get "$ENV" "$key")"
  if [ "$(env_get "$ENV" OGMA_TRANSPORT)" = "matrix" ] && [ -f "$MATRIX_ENV" ]; then
    local matrix_value
    matrix_value="$(env_get "$MATRIX_ENV" "$key")"
    [ -n "$matrix_value" ] && value="$matrix_value"
  fi
  printf '%s' "$value"
}

c_bold=$'\033[1m'; c_dim=$'\033[2m'; c_grn=$'\033[32m'; c_yel=$'\033[33m'; c_red=$'\033[31m'; c_rst=$'\033[0m'
say()  { printf '%s\n' "$*"; }
step() { printf '\n%s==> %s%s\n' "$c_bold" "$*" "$c_rst"; }
ok()   { printf '%s  ✓ %s%s\n' "$c_grn" "$*" "$c_rst"; }
warn() { printf '%s  ! %s%s\n' "$c_yel" "$*" "$c_rst"; }
err()  { printf '%s  ✗ %s%s\n' "$c_red" "$*" "$c_rst"; }
ask()  { local p="$1" d="${2:-}" a; if [ -n "$d" ]; then read -r -p "$p [$d]: " a || true; printf '%s' "${a:-$d}"; else read -r -p "$p: " a || true; printf '%s' "$a"; fi; }
yes()  { local a; a="$(ask "$1 (y/n)" "${2:-y}")"; [[ "$a" =~ ^[Yy] ]]; }

# Set KEY=value in .env, updating an existing (even commented-out) line or appending.
set_env() {
  "$PY" - "$ENV" "$1" "$2" <<'PY'
import re, sys
path, key, val = sys.argv[1:4]
lines = open(path).read().splitlines()
out, done = [], False
for ln in lines:
    if re.match(rf'^#?\s*{re.escape(key)}=', ln):
        out.append(f'{key}={val}'); done = True
    else:
        out.append(ln)
if not done:
    out.append(f'{key}={val}')
open(path, "w").write("\n".join(out) + "\n")
PY
}

# Non-interactive health/config check — `bin/setup --check`. Changes nothing.
do_check() {
  local transport credential allowed credential_label allowed_label llm model dream_model cb codex_bin active_bin u problems=0
  step "Ogma config check  ${c_dim}($OGMA_DIR)${c_rst}"
  transport="$(config_value OGMA_TRANSPORT)"; transport="${transport:-telegram}"
  if [ "$transport" = "matrix" ]; then
    credential="$(config_value MATRIX_ACCESS_TOKEN)"
    allowed="$(config_value MATRIX_ALLOWED_USERS)"
    credential_label="Matrix access token"; allowed_label="Matrix allowed users"
  else
    credential="$(config_value TELEGRAM_BOT_TOKEN)"
    allowed="$(config_value TELEGRAM_ALLOWED_USERS)"
    credential_label="Telegram bot token"; allowed_label="Telegram allowed chats"
  fi
  llm="$(grep -E '^OGMA_LLM=' "$ENV" 2>/dev/null | cut -d= -f2-)"
  cb="$(command -v claude || echo "$HOME/.local/bin/claude")"
  codex_bin="$(command -v codex || echo "$HOME/.local/bin/codex")"
  [ -f "$ENV" ] && ok ".env present" || { err ".env missing — run bin/setup"; problems=1; }
  ok "transport: $transport"
  [ -n "$credential" ] && ok "$credential_label set" || { err "$credential_label MISSING"; problems=1; }
  [ -n "$allowed" ] && ok "$allowed_label: $allowed" || { err "$allowed_label MISSING"; problems=1; }
  if [ "$llm" = "off" ]; then
    ok "LLM layer: off (command-only mode — no assistant CLI needed)"
  else
    model="$(grep -E '^OGMA_MODEL=' "$ENV" 2>/dev/null | cut -d= -f2-)"
    printf '  model     : %s\n' "$(printf '%s\n' "$model" | sed "s/^$/($llm CLI default)/")"
    if [ "$llm" = "codex" ] && [[ "$model" = claude-* ]]; then
      err "Claude model configured for Codex — re-run: bin/setup --reconfigure model"
      problems=1
    fi
    dream_model="$(grep -E '^OGMA_DREAM_MODEL=' "$ENV" 2>/dev/null | cut -d= -f2-)"
    printf '  dream     : %s\n' "$(printf '%s\n' "$dream_model" | sed "s/^$/($llm model/default)/")"
    if { [ "$llm" = "codex" ] && [[ "$dream_model" = claude-* ]]; } ||
       { [ "$llm" = "claude" ] && [[ "$dream_model" = gpt-* ]]; }; then
      err "Dream model belongs to the other harness — re-run: bin/setup --reconfigure model"
      problems=1
    fi
    printf '  effort    : %s\n' "$(grep -E '^OGMA_EFFORT=' "$ENV" 2>/dev/null | cut -d= -f2- | sed 's/^$/(default)/')"
    printf '  fallback  : %s\n' "$(grep -E '^OGMA_FALLBACK_MODEL=' "$ENV" 2>/dev/null | cut -d= -f2- | sed 's/^$/(none)/')"
    active_bin="$cb"; [ "$llm" = "codex" ] && active_bin="$codex_bin"
    [ -x "$active_bin" ] && ok "$llm CLI: $active_bin" || warn "$llm CLI missing ($active_bin)"
  fi
  if [ "$transport" = "telegram" ] && [ -n "$credential" ] && command -v curl >/dev/null; then
    # Token goes to curl via --config on a private fd, not argv (world-readable in /proc).
    u="$(curl -sS -m 12 --config <(printf 'url = "https://api.telegram.org/bot%s/getMe"\n' "$credential") 2>/dev/null | "$PY" -c 'import sys,json
try: d=json.load(sys.stdin)
except Exception: print("?"); raise SystemExit
print(("OK "+((d.get("result") or {}).get("username") or "?")) if d.get("ok") else "BAD")' 2>/dev/null)"
    case "$u" in "OK "*) ok "token valid — bot @${u#OK }";; *) err "token REJECTED by Telegram (getMe failed)"; problems=1;; esac
  fi
  if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
    printf '  service   : %s\n' "$(systemctl --user is-active ogma-gateway 2>/dev/null || echo inactive)"
    printf '  backup    : %s\n' "$(systemctl --user is-active ogma-backup.timer 2>/dev/null || echo inactive)"
  fi
  if [ "$llm" != "off" ]; then
    for s in tickets session-search daily-briefing; do
      skill_root="$HOME/.claude/skills"; [ "$llm" = "codex" ] && skill_root="$HOME/.codex/skills"
      [ -e "$skill_root/$s" ] && ok "skill: $s" || warn "skill not installed for $llm: $s"
    done
  fi
  say ""
  [ "$problems" = 0 ] && say "${c_grn}All good.${c_rst}" || say "${c_yel}Issues found — see above.${c_rst}"
  return "$problems"
}

RECONFIG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --check|check) do_check; exit $? ;;
    --all)         RECONFIG="all"; shift ;;
    --reconfigure|--only)
      RECONFIG="${2:?--reconfigure needs a list, e.g. persona,systemd}"; shift 2 ;;
    -h|--help)
      cat <<EOF
Usage: bin/setup [--check] [--all] [--reconfigure LIST]

  (no args)            first run: full interview. Re-run on an existing install:
                       pick which sections to revisit.
  --check              non-interactive config/health check; changes nothing.
  --all                reconfigure every section (the classic full interview).
  --reconfigure LIST   reconfigure only these sections (comma/space separated).
                       Sections: env llm persona model overlays skills systemd auth
                       e.g. bin/setup --reconfigure systemd,skills
EOF
      exit 0 ;;
    *) err "unknown argument: $1 (try --help)"; exit 2 ;;
  esac
done

say "${c_bold}Ogma setup${c_rst}  ${c_dim}($OGMA_DIR)${c_rst}"
say "This configures your own copy. Nothing is sent anywhere; secrets you enter stay on this box."

# --- Prerequisites -----------------------------------------------------------
step "Checking prerequisites"
command -v "$PY" >/dev/null || { err "python3 not found — install it first."; exit 1; }
ok "python3: $($PY --version 2>&1)"
command -v curl >/dev/null && ok "curl present" || warn "curl not found — message delivery (notify/briefing) needs it."
CLAUDE_BIN="$(command -v claude || true)"; [ -n "$CLAUDE_BIN" ] || CLAUDE_BIN="$HOME/.local/bin/claude"
CODEX_BIN="$(command -v codex || true)"; [ -n "$CODEX_BIN" ] || CODEX_BIN="$HOME/.local/bin/codex"
if [ -x "$CLAUDE_BIN" ]; then ok "claude CLI: $CLAUDE_BIN"; else warn "claude CLI not found at $CLAUDE_BIN — that's fine for command-only mode; install Claude Code (or set CLAUDE_BIN in .env) to enable the assistant layer."; fi
if [ -x "$CODEX_BIN" ]; then ok "codex CLI: $CODEX_BIN"; else warn "codex CLI not found at $CODEX_BIN — install Codex (or set CODEX_BIN) to use that harness."; fi
HAVE_SYSTEMD=0; if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then HAVE_SYSTEMD=1; ok "systemd --user available"; else warn "systemd --user not available — you'll run the gateway manually."; fi

# --- Decide what to (re)configure -------------------------------------------
# First run (no .env) does the full interview. Re-running on an existing install
# lets you pick just the sections you want, so a routine `git pull` + small tweak
# (or installing a newly-added systemd unit) doesn't walk the whole flow again.
SECTIONS="env llm persona model overlays skills systemd auth"
declare -A WANT
if [ -f "$ENV" ]; then
  chmod 600 "$ENV" 2>/dev/null || true
  if [ -n "$RECONFIG" ]; then
    sel="$RECONFIG"
  else
    step "What do you want to (re)configure?"
    say ".env already exists — pick the sections to revisit (the rest stay as-is)."
    say "    1) env       Telegram token / your name / weather location"
    say "    2) llm       assistant harness (Claude Code, OpenAI Codex, or off)"
    say "    3) persona   assistant name / style / language"
    say "    4) model     model / reasoning effort / fallback"
    say "    5) overlays  regenerate host notes + Claude settings overlay"
    say "    6) skills    (re)install skills for Claude Code and Codex"
    say "    7) systemd   (re)install systemd --user units (e.g. after a git pull adds one)"
    say "    8) auth      authorize a Telegram chat"
    say "${c_dim}  Enter numbers or names (comma/space separated), or 'all'. Blank = all.${c_rst}"
    sel="$(ask "Sections" "all")"
  fi
  # Normalize: lowercase, commas -> spaces, then map tokens to section flags.
  for tok in $(printf '%s' "$sel" | tr 'A-Z,' 'a-z '); do
    case "$tok" in
      all)        for s in $SECTIONS; do WANT[$s]=1; done ;;
      1|env)      WANT[env]=1 ;;
      2|llm)      WANT[llm]=1 ;;
      3|persona)  WANT[persona]=1 ;;
      4|model)    WANT[model]=1 ;;
      5|overlays) WANT[overlays]=1 ;;
      6|skills)   WANT[skills]=1 ;;
      7|systemd)  WANT[systemd]=1 ;;
      8|auth)     WANT[auth]=1 ;;
      *) warn "ignoring unknown section '$tok'" ;;
    esac
  done
else
  cp "$EXAMPLE" "$ENV"; chmod 600 "$ENV"; ok "Created .env from template (chmod 600)."
  for s in $SECTIONS; do WANT[$s]=1; done   # first run: do everything
fi
want() { [ -n "${WANT[$1]:-}" ]; }

# Did we touch anything the *running* gateway only reads at startup? If so, we'll
# offer to restart it at the end so the change actually takes effect. (skills/auth
# don't need a gateway restart; systemd's daemon-reload doesn't either.)
NEED_RESTART=0
AUTO_SKILL_PROVIDER=""
for s in env llm persona model overlays; do want "$s" && NEED_RESTART=1; done

# --- .env (token / your name / weather) -------------------------------------
if want env; then
  step "Configuring .env"
  say "${c_dim}Create YOUR OWN bot: message @BotFather in Telegram → /newbot → copy the token.${c_rst}"
  say "${c_dim}(Ogma is self-hosted — this is your private bot, not a shared one.)${c_rst}"
  token="$(ask "Your Telegram bot token (blank to keep current / skip)")"
  if [ -n "$token" ]; then set_env TELEGRAM_BOT_TOKEN "$token"; ok "Token saved."; else warn "No token entered — leaving TELEGRAM_BOT_TOKEN as-is."; fi

  owner="$(ask "Your name (how Ogma addresses you)" "$(grep -E '^OGMA_OWNER_NAME=' "$ENV" 2>/dev/null | cut -d= -f2-)")"
  [ -n "$owner" ] || owner="you"
  set_env OGMA_OWNER_NAME "$owner"; ok "Owner name set to: $owner"
  loc="$(ask "Weather location for the briefing, e.g. Vienna (blank = auto by IP)")"
  [ -n "$loc" ] && { set_env OGMA_WEATHER_LOC "$loc"; ok "Weather location: $loc"; }
fi

# --- Assistant layer: Claude Code or command-only ----------------------------
# The command runner (whitelisted ogmactl commands over Telegram) always works.
# The assistant layer (free-text chat via Claude Code) is optional — without it
# the persona/model/overlays/skills sections have nothing to configure, so
# turning it off also drops them from THIS run.
if want llm; then
step "Assistant layer (optional)"
say "Ogma always runs your predefined commands. The assistant layer adds free-text"
say "chat handled by Claude Code or OpenAI Codex (using that CLI's saved auth on this box)."
cur_llm="$(grep -E '^OGMA_LLM=' "$ENV" 2>/dev/null | cut -d= -f2-)"
choice="$(ask "Harness: claude, codex, or off" "${cur_llm:-claude}")"
case "$(printf '%s' "$choice" | tr '[:upper:]' '[:lower:]')" in
claude)
  set_env OGMA_LLM "claude"; ok "Assistant layer: Claude Code."
  WANT[model]=1
  [ "$cur_llm" = "claude" ] || AUTO_SKILL_PROVIDER="claude"
  [ -x "$CLAUDE_BIN" ] || warn "claude CLI missing — gateway will use command-only mode."
  ;;
codex)
  set_env OGMA_LLM "codex"; ok "Assistant layer: OpenAI Codex."
  WANT[model]=1
  [ "$cur_llm" = "codex" ] || AUTO_SKILL_PROVIDER="codex"
  [ -x "$CODEX_BIN" ] || warn "codex CLI missing — gateway will use command-only mode."
  ;;
*)
  set_env OGMA_LLM "off"; ok "Command-only mode (OGMA_LLM=off)."
  for s in persona model overlays skills; do unset "WANT[$s]"; done
  say "${c_dim}Skipping persona/model/overlays/skills — they only apply to the assistant layer.${c_rst}"
  ;;
esac
if [ "$(grep -E '^OGMA_LLM=' "$ENV" | cut -d= -f2-)" != "off" ]; then
  legacy_mem="$HOME/.claude/projects/$(printf '%s' "$HOME" | sed 's#/#-#g')/memory"
  shared_mem="$legacy_mem"
  mkdir -p "$shared_mem"; chmod 700 "$shared_mem" 2>/dev/null || true
  set_env OGMA_MEMORY_DIR "$shared_mem"
else
  :
fi
fi

# --- Persona (optional: name, style, language) -------------------------------
if want persona; then
step "Persona (optional)"
say "${c_dim}Blank keeps Ogma's defaults. Change any of these later with: bin/ogmactl set-persona <field> <value>${c_rst}"
pname="$(ask "Assistant name (blank = Ogma)")"
set_env OGMA_PERSONA_NAME "$pname"; [ -n "$pname" ] && ok "Name: $pname" || ok "Name: Ogma (default)"
pstyle="$(ask "Conversation style override, e.g. 'terse and dry' (blank = default)")"
set_env OGMA_PERSONA_STYLE "$pstyle"; [ -n "$pstyle" ] && ok "Style: $pstyle"
plang="$(ask "Default language, e.g. German (blank = match whoever writes to you)")"
set_env OGMA_PERSONA_LANG "$plang"; [ -n "$plang" ] && ok "Language: $plang"
fi

# --- Model & reasoning effort ------------------------------------------------
if want model; then
step "Model & reasoning effort"
active_llm="$(grep -E '^OGMA_LLM=' "$ENV" 2>/dev/null | cut -d= -f2-)"
# Live model list needs an API key; Claude Code subscription auth can't list models,
# so this is best-effort — otherwise use the curated aliases (or type any full id).
if [ "$active_llm" = "claude" ] && [ -n "${ANTHROPIC_API_KEY:-}" ]; then
  # The API key goes to curl via --config on a private fd, not argv.
  live="$(curl -sS -m 12 https://api.anthropic.com/v1/models \
            --config <(printf 'header = "x-api-key: %s"\n' "$ANTHROPIC_API_KEY") \
            -H "anthropic-version: 2023-06-01" 2>/dev/null \
          | "$PY" -c '
import sys, json
try:
    d = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for m in d.get("data", []):
    print("   -", m.get("id"))
' 2>/dev/null)"
  [ -n "$live" ] && { say "Models available to your API key:"; printf '%s\n' "$live"; }
fi
if [ "$active_llm" = "codex" ]; then
  say "Enter a Codex model id, or default to follow the CLI's current default."
  current_model="$(grep -E '^OGMA_MODEL=' "$ENV" 2>/dev/null | cut -d= -f2-)"
  case "$current_model" in claude-*) current_model="" ;; esac
  m_choice="$(ask "Model" "${current_model:-default}")"
  case "$(printf '%s' "$m_choice" | tr '[:upper:]' '[:lower:]')" in
    default|"") model_id="" ;; *) model_id="$m_choice" ;;
  esac
else
  say "Pick a model — Claude Code aliases (sonnet is a good default on a Pi):"
  say "  ${c_dim}sonnet = fast · haiku = fastest · opus = most capable but slower · default = Claude Code default · or type a full model id${c_rst}"
  m_choice="$(ask "Model" "sonnet")"
  case "$(printf '%s' "$m_choice" | tr '[:upper:]' '[:lower:]')" in
    sonnet) model_id="claude-sonnet-4-6" ;; haiku) model_id="claude-haiku-4-5" ;;
    opus) model_id="claude-opus-4-8" ;; default|"") model_id="" ;; *) model_id="$m_choice" ;;
  esac
fi
set_env OGMA_MODEL "$model_id"; ok "Model: ${model_id:-(CLI default)}"

# Dream is an unattended invocation of the selected harness, so its model must
# switch providers with the harness too. Keep one canonical setting rather than
# leaving a stale Claude model beside a Codex selection (or vice versa).
if [ "$active_llm" = "claude" ]; then
  dream_model="${model_id:-claude-sonnet-4-6}"
else
  dream_model="$model_id"
fi
set_env OGMA_DREAM_MODEL "$dream_model"
# Clear the old provider-specific override so it cannot resurrect after a switch.
set_env OGMA_CODEX_DREAM_MODEL ""
ok "Dream model: ${dream_model:-($active_llm CLI default)}"

eff_options="low/medium/high/xhigh/max"; [ "$active_llm" = "codex" ] && eff_options="low/medium/high/xhigh"
current_effort="$(grep -E '^OGMA_EFFORT=' "$ENV" 2>/dev/null | cut -d= -f2-)"
case "$current_effort" in low|medium|high|xhigh) ;; max) [ "$active_llm" = "claude" ] || current_effort="" ;; *) current_effort="" ;; esac
eff="$(ask "Reasoning effort — $eff_options" "${current_effort:-default}")"
effl="$(printf '%s' "$eff" | tr '[:upper:]' '[:lower:]')"
case "$effl" in
  low|medium|high|xhigh) set_env OGMA_EFFORT "$effl"; ok "Effort: $effl" ;;
  max) if [ "$active_llm" = "claude" ]; then set_env OGMA_EFFORT max; ok "Effort: max";
       else warn "Codex does not support max — leaving at default."; set_env OGMA_EFFORT ""; fi ;;
  ""|default)                set_env OGMA_EFFORT "";     ok "Effort: default" ;;
  *)                         warn "Unknown effort '$eff' — leaving at default."; set_env OGMA_EFFORT "" ;;
esac

say "${c_dim}A fallback model is used automatically if the main one is unavailable (rate limit/outage).${c_rst}"
fb="$(ask "Fallback model — alias or full id (blank = none)")"
case "$(printf '%s' "$fb" | tr '[:upper:]' '[:lower:]')" in
  ""|none|off) set_env OGMA_FALLBACK_MODEL "";                     ok "Fallback: none" ;;
  sonnet|haiku|opus)
    if [ "$active_llm" = "claude" ]; then
      case "${fb,,}" in sonnet) fb_id=claude-sonnet-4-6;; haiku) fb_id=claude-haiku-4-5;; opus) fb_id=claude-opus-4-8;; esac
      set_env OGMA_FALLBACK_MODEL "$fb_id"; ok "Fallback: $fb_id"
    else
      set_env OGMA_FALLBACK_MODEL "$fb"; ok "Fallback: $fb"
    fi ;;
  *)           set_env OGMA_FALLBACK_MODEL "$fb";                  ok "Fallback: $fb" ;;
esac
fi

# --- Host-local overlays (gitignored; merged at runtime) ---------------------
# We DON'T edit the tracked workspace/CLAUDE.md or settings.json in place — that
# would dirty them on every install and block `git pull`. Instead we generate two
# gitignored overlay files that Claude Code merges at runtime: CLAUDE.local.md
# (imported via `@CLAUDE.local.md` in the persona) and settings.local.json (layered
# over settings.json). Same core+local split as ogmactl/ogmactl.local and .env.
if want overlays; then
step "Writing host-local overlays (gitignored)"
# Read the owner from .env so this works even when the 'env' section wasn't selected.
owner="$(grep -E '^OGMA_OWNER_NAME=' "$ENV" 2>/dev/null | cut -d= -f2-)"; [ -n "$owner" ] || owner="you"
# Canonical auto-memory dir (same derivation the dream/briefing use: $HOME with / -> -).
mem_dir="$(grep -E '^OGMA_MEMORY_DIR=' "$ENV" 2>/dev/null | cut -d= -f2-)"
[ -n "$mem_dir" ] || mem_dir="$HOME/.claude/projects/$(printf '%s' "$HOME" | sed 's#/#-#g')/memory"
cat > "$OGMA_DIR/workspace/CLAUDE.local.md" <<EOF
## Host notes (this machine)

Generated by \`bin/setup\` and imported by the tracked \`CLAUDE.md\` (\`@CLAUDE.local.md\`),
so the shared persona stays generic while this host's specifics live here (gitignored).

- The person you serve is **$owner**.
- Your Ogma directory: \`$OGMA_DIR\`
- Your control helper is \`ogmactl\` — always call it by this absolute path:
  \`$OGMA_DIR/bin/ogmactl\`
- Persistent memory directory:
  \`$mem_dir\`
- Beyond the core subcommands, this host may define extra \`ogmactl\` commands. To see the
  current list, run \`$OGMA_DIR/bin/ogmactl help\`.
EOF
# If the operator keeps a reference doc for their host-local commands, point the
# persona at it so the bot can answer "how does command X work" questions.
if [ -f "$OGMA_DIR/docs/commands.local.md" ]; then
cat >> "$OGMA_DIR/workspace/CLAUDE.local.md" <<EOF
- Reference for those host-local commands (usage, arguments, gotchas):
  \`$OGMA_DIR/docs/commands.local.md\` — read it when asked how a command works
  or what options exist.
EOF
fi
# Append the persona-override block (name/style/language) into the same overlay,
# rendered from the OGMA_PERSONA_* values just written to .env. Shared with
# `ogmactl set-persona` so both write the block identically.
# shellcheck source=/dev/null
. "$OGMA_DIR/bin/_persona.sh"
persona_render "$ENV" "$OGMA_DIR/workspace/CLAUDE.local.md"
cp "$OGMA_DIR/workspace/CLAUDE.local.md" "$OGMA_DIR/workspace/AGENTS.local.md"
cat > "$OGMA_DIR/workspace/.claude/settings.local.json" <<EOF
{
  "permissions": {
    "allow": [
      "Bash($OGMA_DIR/bin/ogmactl:*)"
    ],
    "additionalDirectories": [
      "$mem_dir"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$OGMA_DIR/hooks/persist-nudge.py",
            "timeout": 10,
            "statusMessage": "Checking for anything worth remembering…"
          }
        ]
      }
    ]
  }
}
EOF
ok "Wrote workspace/CLAUDE.local.md and workspace/.claude/settings.local.json (gitignored)."
fi

# --- Permissions (always — makes pulled-in scripts executable) ---------------
step "Setting executable permissions"
chmod +x "$OGMA_DIR"/bin/* "$OGMA_DIR"/hooks/*.py 2>/dev/null || true
ok "bin/ and hooks/ are executable."

# --- Skills ------------------------------------------------------------------
# A harness switch must leave the newly selected CLI ready to use. Install only
# missing bundled skills here: an existing target may be locally customised and
# is never overwritten implicitly. The explicit skills section below remains
# available for reviewing/updating differing copies.
if [ -n "$AUTO_SKILL_PROVIDER" ]; then
step "Transferring Ogma skills to $AUTO_SKILL_PROVIDER"
case "$AUTO_SKILL_PROVIDER" in
  claude) auto_skill_root="$HOME/.claude/skills" ;;
  codex)  auto_skill_root="$HOME/.codex/skills" ;;
esac
mkdir -p "$auto_skill_root"
for s in tickets session-search daily-briefing; do
  src="$OGMA_DIR/skills/$s"
  dest="$auto_skill_root/$s"
  if [ -e "$dest" ] || [ -L "$dest" ]; then
    ok "$s already present for $AUTO_SKILL_PROVIDER."
  else
    cp -r "$src" "$dest"
    ok "transferred $s to $AUTO_SKILL_PROVIDER."
  fi
done
fi

if want skills; then
step "Installing skills (tickets, session-search, daily-briefing)"
if yes "Install skills for both Claude Code and Codex?" "y"; then
  mkdir -p "$HOME/.claude/skills" "$HOME/.codex/skills"
  for s in tickets session-search daily-briefing; do
    src="$OGMA_DIR/skills/$s"
    for skill_root in "$HOME/.claude/skills" "$HOME/.codex/skills"; do
    dest="$skill_root/$s"
    if [ -L "$dest" ]; then
      ok "$s is a symlink — already tracks the repo."
    elif [ -e "$dest" ]; then
      # Copies go stale after a `git pull`; offer the repo version, but never
      # clobber a locally customised skill without asking.
      if diff -rq "$src" "$dest" >/dev/null 2>&1; then
        ok "$s up to date."
      elif yes "  $s differs from the repo version — overwrite with the repo copy?" "n"; then
        rm -rf "$dest" && cp -r "$src" "$dest" && ok "updated $s"
      else
        warn "$s left as-is (kept your local version)."
      fi
    else
      cp -r "$src" "$dest"; ok "installed $s"
    fi
    done
  done
  say "${c_dim}(Tip: symlink from either skills directory to $OGMA_DIR/skills/<name> to track updates.)${c_rst}"
else
  warn "Skipped. The 'tickets' skill is what drives the workflow — install it later from skills/."
fi
fi

# --- systemd ------------------------------------------------------------------
if want systemd && [ "$HAVE_SYSTEMD" = 1 ]; then
  step "Installing systemd --user services"
  if yes "Install the systemd units now?" "y"; then
    UD="$HOME/.config/systemd/user"; mkdir -p "$UD"
    sys_skipped=0; llm_skipped=0
    # Command-only installs don't get the assistant-layer units (each run is a
    # full claude invocation — see bin/briefing / bin/dream, which also guard).
    llm_now="$(grep -E '^OGMA_LLM=' "$ENV" 2>/dev/null | cut -d= -f2-)"
    for f in "$OGMA_DIR"/systemd/*; do
      base="$(basename "$f")"
      # System units (they pin a User=) can't run under `systemctl --user`.
      # Skip them here; they're installed to /etc/systemd/system (see README).
      if grep -q '{{USER}}' "$f"; then sys_skipped=1; continue; fi
      case "$base" in
        ogma-briefing.*|ogma-dream.*)
          [ "$llm_now" = "off" ] && { llm_skipped=1; continue; } ;;
      esac
      sed "s|{{OGMA_DIR}}|$OGMA_DIR|g; s|{{HOME}}|$HOME|g" "$f" > "$UD/$base"
    done
    systemctl --user daemon-reload
    ok "Units installed to $UD and daemon reloaded."
    [ "$sys_skipped" = 1 ] && say "${c_dim}Note: system units (e.g. ogma-pihole-watch) were skipped — see README to install them under /etc/systemd/system.${c_rst}"
    [ "$llm_skipped" = 1 ] && say "${c_dim}Note: assistant-layer units (briefing/dream) were skipped — command-only mode. Re-run setup after enabling the LLM to install them.${c_rst}"
    if yes "Enable linger (keep services running when you're logged out)?" "y"; then
      loginctl enable-linger "$USER" 2>/dev/null && ok "Linger enabled." || warn "Could not enable linger (may need: sudo loginctl enable-linger $USER)."
    fi
    if [ "$llm_now" = "off" ]; then
      say "${c_dim}Optional routines: systemctl --user enable --now ogma-health.timer ogma-backup.timer ogma-logtrim.timer${c_rst}"
    else
      say "${c_dim}Optional routines: systemctl --user enable --now ogma-briefing.timer ogma-dream.timer ogma-health.timer ogma-backup.timer ogma-logtrim.timer${c_rst}"
    fi
  else
    warn "Skipped. Templates are in systemd/ — install them manually later (see README)."
  fi
fi

# --- First-run: discover & authorize chat ID --------------------------------
if want auth; then
step "Authorizing your chat"
# Read straight from .env (NOT the prompt vars) so re-runs that kept an existing
# token/allow-list behave correctly.
tok="$(grep -E '^TELEGRAM_BOT_TOKEN=' "$ENV" | cut -d= -f2-)"
allowed="$(grep -E '^TELEGRAM_ALLOWED_USERS=' "$ENV" | cut -d= -f2-)"

# Accept an integer chat ID (negative allowed for groups) or a comma-list of them.
valid_ids() { [[ "$1" =~ ^-?[0-9]+(,[[:space:]]*-?[0-9]+)*$ ]]; }

if [ -n "$allowed" ]; then
  ok "TELEGRAM_ALLOWED_USERS already set: $allowed"
elif [ -z "$tok" ]; then
  warn "No bot token in .env — set TELEGRAM_BOT_TOKEN first, then re-run setup to authorize."
else
  # 1) Confirm the token actually works before asking you to message the bot.
  botuser="$(API_TOK="$tok" "$PY" - <<'PY'
import os, json, urllib.request, urllib.error
tok = os.environ["API_TOK"]
try:
    with urllib.request.urlopen(f"https://api.telegram.org/bot{tok}/getMe", timeout=15) as r:
        d = json.load(r)
except urllib.error.HTTPError as e:
    print("INVALID" if e.code == 401 else f"HTTPERR {e.code}"); raise SystemExit
except Exception as e:
    print("NETERR " + str(e)[:80]); raise SystemExit
print(("OK " + (d["result"].get("username") or "?")) if d.get("ok") else "INVALID")
PY
)"
  case "$botuser" in
    "OK "*) bot_un="@${botuser#OK }"; ok "Token valid — bot is $bot_un" ;;
    INVALID) err "Telegram rejects this token (Unauthorized). Re-run setup and paste the exact token from @BotFather (/mybots → API Token)."; bot_un="" ;;
    NETERR*) err "Couldn't reach Telegram (${botuser#NETERR }). Check connectivity and re-run."; bot_un="" ;;
    *) err "Unexpected response while validating token ($botuser)."; bot_un="" ;;
  esac

  if [ -n "$bot_un" ]; then
    # 2) Make sure nothing else is polling this bot — a running gateway would grab
    #    your message before we can read it. Pause the service; resume it after.
    PAUSED=0
    if [ "$HAVE_SYSTEMD" = 1 ] && systemctl --user is-active --quiet ogma-gateway 2>/dev/null; then
      systemctl --user stop ogma-gateway && { PAUSED=1; warn "Paused running ogma-gateway during detection."; }
    fi

    while true; do
      say "Open Telegram and send ${c_bold}$bot_un${c_rst} any message (e.g. \"hi\")."
      read -r -p "Press Enter once you've sent it… " _ || true
      say "${c_dim}Listening for your message (up to ~45s)…${c_rst}"
      det="$(API_TOK="$tok" POLL_SECS=45 "$PY" - <<'PY'
import os, json, time, urllib.request, urllib.error
tok = os.environ["API_TOK"]; deadline = time.time() + int(os.environ.get("POLL_SECS", "45"))
seen = {}
while time.time() < deadline:
    try:
        # Non-destructive read (no offset): the gateway can still pick the message up later.
        with urllib.request.urlopen(f"https://api.telegram.org/bot{tok}/getUpdates?timeout=5", timeout=20) as r:
            d = json.load(r)
    except urllib.error.HTTPError as e:
        print("CONFLICT" if e.code == 409 else ("INVALID" if e.code == 401 else f"HTTPERR {e.code}")); raise SystemExit
    except Exception:
        time.sleep(2); continue
    if not d.get("ok"):
        ec = d.get("error_code")
        if ec == 409: print("CONFLICT"); raise SystemExit
        if ec == 401: print("INVALID"); raise SystemExit
        time.sleep(2); continue
    for u in d.get("result", []):
        m = u.get("message") or u.get("edited_message") or {}
        c = m.get("chat") or {}
        if c.get("id") is not None:
            seen[c["id"]] = c.get("username") or c.get("first_name") or c.get("title") or ""
    if seen:
        break
    time.sleep(1)
if not seen:
    print("NONE")
else:
    for cid, nm in seen.items():
        print(f"ID\t{cid}\t{nm}")
PY
)"
      case "$det" in
        CONFLICT)
          err "Another process is already polling this bot (Telegram 409). Stop it and retry — e.g. 'systemctl --user stop ogma-gateway', or kill a manual 'python3 gateway.py'." ;;
        INVALID)
          err "Token became unauthorized. Fix TELEGRAM_BOT_TOKEN and re-run setup."; break ;;
        NONE|"")
          warn "Didn't see a message in the window." ;;
        HTTPERR*)
          err "Telegram error during detection ($det)." ;;
        *)
          ids_csv="$(printf '%s\n' "$det" | awk -F'\t' '$1=="ID"{print $2}' | paste -sd, -)"
          if [ -n "$ids_csv" ]; then
            say "Detected chat ID(s):"
            printf '%s\n' "$det" | awk -F'\t' '$1=="ID"{printf "  %s  (%s)\n", $2, $3}'
            pick="$(ask "Chat ID(s) to authorize (comma-separated)" "$ids_csv")"
            if valid_ids "$pick"; then set_env TELEGRAM_ALLOWED_USERS "${pick// /}"; ok "Authorized: $pick"; break
            else err "Not a valid chat ID."; fi
          else
            warn "Unexpected detection output; will offer to retry."
          fi ;;
      esac

      # Not authorized yet — retry, type the ID by hand, or skip.
      choice="$(ask "Retry detection (r), enter ID manually (m), or skip (s)?" "r")"
      case "$choice" in
        m|M)
          man="$(ask "Your Telegram chat ID(s), comma-separated (find it via @userinfobot)")"
          if valid_ids "$man"; then set_env TELEGRAM_ALLOWED_USERS "${man// /}"; ok "Authorized: $man"; break
          else err "That doesn't look like a numeric chat ID."; fi ;;
        s|S)
          warn "Skipped — set TELEGRAM_ALLOWED_USERS in .env later, then restart the gateway."; break ;;
        *) : ;;  # loop and retry detection
      esac
    done

    # Resume the gateway if we paused it.
    if [ "$PAUSED" = 1 ]; then
      systemctl --user start ogma-gateway && ok "Resumed ogma-gateway." || warn "Couldn't resume ogma-gateway — start it manually."
    fi
  fi
fi
fi

# --- Done --------------------------------------------------------------------
step "Done"
transport="$(config_value OGMA_TRANSPORT)"; transport="${transport:-telegram}"
if [ "$transport" = "matrix" ]; then
  credential="$(config_value MATRIX_ACCESS_TOKEN)"
  allowed="$(config_value MATRIX_ALLOWED_USERS)"
  credential_label="Matrix token"; allowed_label="Matrix users"
else
  credential="$(config_value TELEGRAM_BOT_TOKEN)"
  allowed="$(config_value TELEGRAM_ALLOWED_USERS)"
  credential_label="Telegram token"; allowed_label="Telegram chats"
fi

llm_mode="$(grep -E '^OGMA_LLM=' "$ENV" | cut -d= -f2-)"
say "${c_bold}Config summary${c_rst}"
printf '  transport     : %s\n' "$transport"
printf '  %-13s : %s\n' "$credential_label" "$([ -n "$credential" ] && echo set || echo MISSING)"
printf '  %-13s : %s\n' "$allowed_label" "${allowed:-MISSING}"
printf '  llm           : %s\n' "${llm_mode:-claude}"
if [ "$llm_mode" = "off" ]; then
  printf '  mode          : command-only\n'
else
  printf '  model         : %s\n' "$(grep -E '^OGMA_MODEL=' "$ENV" | cut -d= -f2- | sed "s/^$/($llm_mode CLI default)/")"
  printf '  dream model   : %s\n' "$(grep -E '^OGMA_DREAM_MODEL=' "$ENV" | cut -d= -f2- | sed "s/^$/($llm_mode model/default)/")"
  printf '  effort        : %s\n' "$(grep -E '^OGMA_EFFORT=' "$ENV" | cut -d= -f2- | sed 's/^$/(default)/')"
  printf '  fallback      : %s\n' "$(grep -E '^OGMA_FALLBACK_MODEL=' "$ENV" | cut -d= -f2- | sed 's/^$/(none)/')"
  if [ "$llm_mode" = "codex" ]; then
    printf '  codex CLI     : %s\n' "$([ -x "$CODEX_BIN" ] && echo "$CODEX_BIN" || echo MISSING)"
  else
    printf '  claude CLI    : %s\n' "$([ -x "$CLAUDE_BIN" ] && echo "$CLAUDE_BIN" || echo MISSING)"
  fi
fi
{ [ -n "$credential" ] && [ -n "$allowed" ]; } || warn "$credential_label and/or $allowed_label missing — Ogma won't respond until both are set."
if [ "$llm_mode" = "claude" ] && [ ! -x "$CLAUDE_BIN" ]; then
  warn "claude CLI not found — the gateway runs command-only until it is installed."
elif [ "$llm_mode" = "codex" ] && [ ! -x "$CODEX_BIN" ]; then
  warn "codex CLI not found — the gateway runs command-only until it is installed."
fi

if [ "$HAVE_SYSTEMD" = 1 ] && [ -n "$credential" ] && [ -n "$allowed" ]; then
  if systemctl --user is-active --quiet ogma-gateway 2>/dev/null; then
    # Already running. The gateway reads .env/persona/overlays at startup, so changes
    # to those only take effect on a restart — offer one if we touched them.
    if [ "$NEED_RESTART" = 1 ]; then
      if yes "Restart the gateway now to apply your changes?" "y"; then
        systemctl --user restart ogma-gateway && ok "Gateway restarted. Logs: journalctl --user -u ogma-gateway -f" || err "Restart failed — check: systemctl --user status ogma-gateway"
      else
        say "${c_dim}Your changes apply on the next restart: ogmactl restart${c_rst}"
      fi
    else
      ok "Gateway is running (nothing changed that needs a restart)."
    fi
  elif yes "Start the gateway now (systemctl --user enable --now ogma-gateway)?" "y"; then
    systemctl --user enable --now ogma-gateway && ok "Gateway started. Logs: journalctl --user -u ogma-gateway -f" || err "Failed to start — check: systemctl --user status ogma-gateway"
  fi
else
  say "Next: once token + allowed users are set, start it:"
  say "  ${c_dim}systemctl --user enable --now ogma-gateway${c_rst}   (or: python3 $OGMA_DIR/gateway.py)"
fi
say ""
say "Read ${c_bold}docs/workflow.md${c_rst} for how Ogma is meant to be used. Enjoy."
