[Unit]
Description=Ogma Telegram gateway (Claude Code personal assistant)
After=network-online.target
Wants=network-online.target
# A config error (missing token/CLI) exits immediately; without this guard
# Restart=on-failure loops every 5s forever, flooding the log.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{OGMA_DIR}}
ExecStart=/usr/bin/python3 {{OGMA_DIR}}/gateway.py
StandardOutput=append:{{OGMA_DIR}}/gateway.log
StandardError=append:{{OGMA_DIR}}/gateway.log
Restart=on-failure
RestartSec=5
# Make sure the claude binary's dir is on PATH for the service
Environment=PATH={{HOME}}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Hardening. UMask keeps the appended log 600 — it carries chat content.
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
